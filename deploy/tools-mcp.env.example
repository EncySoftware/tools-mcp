# /opt/tools-mcp/tools-mcp.env on the tools server (chmod 600). It holds no secret: tools-mcp has no key.
#
# Whose access tokens are taken (their azp): Hermes's Keycloak client, and the site's own - a `tools-mcp login` token
# checks the server before Hermes connects. Without this line (or TOOLS_MCP_AUDIENCE) the server does not start.
TOOLS_MCP_CLIENTS=dealerspace-mcp,tools-encycam
#
# An audience a token must carry instead, once the agent's client has an audience mapper:
# TOOLS_MCP_AUDIENCE=tools-mcp
# The defaults:
# TOOLS_MCP_ISSUER=https://webservices.encycam.com/keycloak/realms/licsys
# TOOLS_MCP_PUBLIC_URL=https://tools.encycam.com
